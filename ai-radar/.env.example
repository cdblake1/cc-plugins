# Copy to .env and fill in as needed. Nothing here is required for the free default path.

# Optional: enables the paid `--mode claude` summarization. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional: better YouTube relevance via the YouTube Data API (free 10k-unit/day quota).
# Without it, discovery falls back to yt-dlp search (also free).
YOUTUBE_API_KEY=

# Behind a TLS-intercepting corporate proxy? Point these at your setup so HTTPS verifies.
# HTTPS_PROXY=http://proxy.corp:8080
# CA_BUNDLE=/etc/ssl/certs/corp-root-ca.pem

# Optional: override the SQLite store location (default ~/.local/share/ai-radar/store.db)
# AI_RADAR_DB=/path/to/store.db
